{
  "_readme": "Example: Mori hooks (_mori_managed) plus personal dotfiles hooks (_dotfiles_managed). Mori: install-mori-cursor.*. Dotfiles: ~/dotfiles/scripts/install-dotfiles-cursor-hooks.sh",
  "mcpServers": {
    "mori": {
      "type": "http",
      "url": "http://localhost:8968/mcp"
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "\"$HOME/dotfiles/hooks/git-push-guard.sh\"",
        "_dotfiles_managed": true
      },
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw",
        "_mori_managed": true
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw",
            "_mori_managed": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "\"$HOME/dotfiles/hooks/session-start.sh\"",
        "_dotfiles_managed": true
      },
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw",
        "_mori_managed": true
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw",
        "_mori_managed": true
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode precompact",
        "_mori_managed": true
      }
    ],
    "PostCompact": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-post-compact-brief.sh\"",
        "_mori_managed": true
      }
    ]
  }
}
