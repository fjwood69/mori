{
  "_readme": "Generated by install-mori-*.sh/ps1. Linux/macOS: hooks call ~/.claude/mori-ship-event.sh. Windows: hooks call %USERPROFILE%\\.claude\\mori-ship-event.ps1. Replace 'my-hostname' with your client name.",
  "mcpServers": {
    "mori": {
      "type": "http",
      "url": "http://localhost:8968/mcp"
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw"
      }
    ],
    "PostToolUseFailure": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw"
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode precompact"
      }
    ]
  }
}
