{
  "_readme": "Cursor manual example. install-mori-cursor.* adds _mori_managed on each hook. Linux/macOS: ~/.claude/mori-ship-event.sh. Windows: mori-ship-event.ps1. Replace my-hostname.",
  "mcpServers": {
    "mori": {
      "type": "http",
      "url": "http://localhost:8968/mcp"
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw",
        "_mori_managed": true
      }
    ],
    "PostToolUseFailure": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw",
        "_mori_managed": true
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw",
        "_mori_managed": true
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode raw",
        "_mori_managed": true
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "\"$HOME/.claude/mori-ship-event.sh\" --url \"http://localhost:8968\" --client \"my-hostname\" --mode precompact",
        "_mori_managed": true
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/mori-post-compact-brief.sh\"",
            "_mori_managed": true
          }
        ]
      }
    ]
  }
}
