[Unit]
Description=Moku-advisor (rootless Podman)
Documentation=https://github.com/fjwood69/ai-stack
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStart=/usr/bin/podman run --rm --name moku-advisor \
  --network=host \
  -v /data/moku-advisor:/data/moku-advisor:Z \
  --env-file /etc/moku-advisor.env \
  localhost/moku-advisor:latest
ExecStop=/usr/bin/podman stop moku-advisor
ExecReload=/usr/bin/podman restart moku-advisor

[Install]
WantedBy=default.target