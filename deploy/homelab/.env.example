# Mori — Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# At minimum you need:
#   - A provider API key
#   - A model for advisory and dream (can be the same model)
#
# If you're using Bifrost (https://github.com/fjwood69/bifrost) as your gateway,
# set MORI_PROVIDER_MODE=bifrost and skip MORI_API_KEY / MORI_BASE_URL.
# Bifrost handles provider routing, keys, and fallbacks.
#
# New users without a gateway: use MORI_PROVIDER_MODE=direct.

# ---------------------------------------------------------------------------
# Provider — choose "direct" or "bifrost"
# ---------------------------------------------------------------------------

# "direct" = talk to an OpenAI-compatible API (Novita, DeepInfra, OpenAI, etc.)
# "bifrost" = route through a Bifrost gateway on localhost:8787
MORI_PROVIDER_MODE=direct

# Provider API key (required in direct mode)
# Novita:   https://novita.ai
# DeepInfra: https://deepinfra.com
# OpenAI:   https://platform.openai.com
MORI_API_KEY=sk-your-provider-key-here

# OpenAI-compatible base URL (required in direct mode)
MORI_BASE_URL=https://api.novita.ai/v3/openai

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

# Advisor model — used by /consult for strategic guidance
# Pick a model with strong reasoning. Kimi K2.6 is a good default.
MORI_MODEL=moonshotai/kimi-k2.6

# Dream model — distills session events into memories
# Falls back to MORI_MODEL if not set. Can be a smaller/cheaper model.
# MORI_DREAM_MODEL=moonshotai/kimi-k2.6

# ---------------------------------------------------------------------------
# Trusted Dreamers
# ---------------------------------------------------------------------------

# Comma-separated hostnames that can write directly to protected memories
# and approve/reject pending writes from other instances.
# Set this to your machine's hostname so your writes don't need approval.
MORI_TRUSTED_DREAMERS=your-hostname

# ---------------------------------------------------------------------------
# Dream scheduling
# ---------------------------------------------------------------------------

# How often the dream pipeline runs, in minutes.
# Solo: 240 (4 hours)
# 1–4 people: 60 (1 hour)
# 5–10 people: 30
MORI_DREAM_INTERVAL=60

# ---------------------------------------------------------------------------
# Team standards (optional)
# ---------------------------------------------------------------------------

# Path to a directory of .md files organised by category:
#   /path/to/standards/
#     ethos/
#       values-and-ethical-principles.md
#     security/
#       security-baseline.md
#       pii-handling.md
#     coding/
#       python-style-guide.md
#
# Each .md file becomes a protected memory with tags from its subdirectory.
# Standards are read-only to non-trusted dreamers.
# The mori repo ships a built-in set; uncomment to point at custom ones.
# MORI_STANDARDS_DIR=/app/standards

# ---------------------------------------------------------------------------
# API auth (optional)
# ---------------------------------------------------------------------------

# API key for the event capture endpoint (POST /api/events/raw).
# If left empty, event capture is unauthenticated (fine on localhost or
# Tailscale-only networks).
# MORI_ADVISOR_API_KEY=your-event-capture-key

# ---------------------------------------------------------------------------
# Server identity
# ---------------------------------------------------------------------------

# Prefix for MCP tool names. Default is "mori_advisor" (tools appear as
# mori_advisor-memory_search, mori_advisor-dream_run, etc.)
# MORI_MCP_SERVER_NAME=mori_advisor

# ---------------------------------------------------------------------------
# Data directory (container internal — mapped via volume, don't change)
# ---------------------------------------------------------------------------
# MORI_ADVISOR_DATA=/data/mori-advisor