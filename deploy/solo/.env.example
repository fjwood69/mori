# Mori — Solo deployment environment
# Copy to .env and fill in the required values.

# ── Required ───────────────────────────────────────────────────────────────

# LLM provider — Bifrost gateway (recommended) or direct OpenAI-compatible
MORI_PROVIDER_MODE=bifrost
MORI_BIFROST_BASE_URL=http://localhost:8787

# ── Authentication ─────────────────────────────────────────────────────────
# Named API keys — one per client (name:secret pairs, comma-separated).
# Generate secrets: python3 -c "import secrets; print(secrets.token_hex(32))"
# Or use the mori-key_generate MCP tool once the server is running.
#
# If unset, server runs in OPEN MODE — anyone on the network can connect.
# Acceptable on a private Tailscale network; set keys for team deployments.
#
# MORI_API_KEYS=myhost:abc123...,teammate:def456...
#
# Legacy single-key (backward compat — prefer MORI_API_KEYS for new deployments)
# MORI_ADVISOR_API_KEY=

# ── Optional ───────────────────────────────────────────────────────────────

# Dream pipeline interval in minutes (default: 60)
MORI_DREAM_INTERVAL=60

# NATS URL for cross-device messaging (leave unset if not using mori-msg)
# MORI_NATS_URL=nats://user:pass@nats-host:4222

# Trusted dreamers — hostnames that can approve canonical writes
# MORI_TRUSTED_DREAMERS=my-machine,team-server

# MCP server name (shown in Claude Code sidebar)
MORI_MCP_SERVER_NAME=mori

# ── SQLite (default) ────────────────────────────────────────────────────────
# No MORI_DATABASE_URL = SQLiteStore. Data at /data/mori-advisor/memories.db.
# For PostgreSQL, see deploy/team/.env.example.

# ── Litestream backups (optional) ─────────────────────────────────────────
# Set LITESTREAM_GCS_BUCKET to activate continuous replication to GCS.
# Unset = sidecar idles, no backup. Set = replicates every 10s, snapshot 6h.
# LITESTREAM_GCS_BUCKET=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json
