#!/usr/bin/env bash
# /usr/local/sbin/mori-cd-deploy-as-mori — root:root 0755, run as mori by the one sudoers rule.
# The deploy itself (formerly the here-document in cd.yml): pin the rollback image, pull BY DIGEST,
# tag, convert the key table to hashes (v2.3.17+), restart the units, health gate, store check
# (v2.3.17+, fails closed). The HTTP contract then runs from the CD runner with CD's own key.
set -euo pipefail
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
TAG_RE='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
DIGEST_RE='^sha256:[0-9a-f]{64}$'
TAG="${1:-}"; DIGEST="${2:-}"; MODE="${3:-run}"
[[ "$TAG" =~ $TAG_RE ]] || { echo "refused: bad tag" >&2; exit 2; }
[[ "$DIGEST" =~ $DIGEST_RE ]] || { echo "refused: bad digest" >&2; exit 2; }
VERSION="${TAG#v}"
ENVFILE="${MORI_CD_ENVFILE_FOR_TESTS:-/data/mori-advisor/.env}"
[[ "$MODE" == "--plan" ]] || ENVFILE=/data/mori-advisor/.env  # the override exists for --plan only
SELF_DIR=/usr/local/sbin
HASH_KEYS=/usr/local/sbin/mori-hash-keys.py
IMAGE_PINNED="ghcr.io/fjwood69/mori@${DIGEST}"
IMAGE_VERSION="ghcr.io/fjwood69/mori:${VERSION}"
IMAGE_LATEST="ghcr.io/fjwood69/mori:latest"
IMAGE_ROLLBACK="ghcr.io/fjwood69/mori:previous-rollback"
UNITS="mori-advisor mori-ingestion mori-msg"

at_least_2317() { [[ "$(printf '%s\n' 2.3.17 "$VERSION" | sort -V | head -1)" == "2.3.17" ]]; }
table_is_hashed() { grep -qE '^\s*(export\s+)?MORI_API_KEYS\s*=.*:sha256:[0-9a-f]{64}' "$ENVFILE"; }

# Unreadable or unwritable is a failure, never "not hashed" (consult C17, P3-4).
[[ -f "$ENVFILE" && -r "$ENVFILE" && -w "$ENVFILE" ]] || { echo "FATAL: $ENVFILE missing, unreadable or unwritable" >&2; exit 1; }
if at_least_2317; then
  CONVERT=yes; STORE_CHECK=yes
else
  CONVERT=no; STORE_CHECK=no
  # v2.3.16 and earlier read a hashed entry as a literal plain secret: every client would fail.
  if table_is_hashed; then
    echo "refused: the key table is hashed and $TAG cannot read hashes — restore the plain table" \
         "(Fred's off-host copy, break-glass) before deploying an older release" >&2
    exit 3
  fi
fi

# `sudo -n -u mori` keeps the caller's directory and does not set HOME (board, build ruling: Cursor).
# Rootless podman needs mori's own home (its storage and config live there) and a directory mori can
# enter, so both are set here, before any podman command — what `sudo su - mori` used to give.
ME="$(id -un)"
ME_HOME="$(getent passwd "$ME" | cut -d: -f6)"
[[ -n "$ME_HOME" && -d "$ME_HOME" ]] || { echo "FATAL: no home directory for $ME" >&2; exit 1; }
export HOME="$ME_HOME" USER="$ME" LOGNAME="$ME"
cd /tmp

if [[ "$MODE" == "--plan" ]]; then
  echo "plan tag=$TAG convert=$CONVERT store_check=$STORE_CHECK home=$HOME cwd=$PWD"; exit 0
fi

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
# `sudo -n -u mori` opens no login session; the user manager exists only with linger (C17, P3-5).
[[ -d "$XDG_RUNTIME_DIR" ]] || { echo "FATAL: no systemd user runtime for $ME (is linger enabled?)" >&2; exit 1; }

# Rollback tag: pin the currently-running :latest before it moves.
if podman image exists "$IMAGE_LATEST"; then podman tag "$IMAGE_LATEST" "$IMAGE_ROLLBACK"; fi
# Pull the build BY DIGEST and move :latest onto it (the units reference :latest, no re-pull).
podman pull "$IMAGE_PINNED"
podman tag "$IMAGE_PINNED" "$IMAGE_VERSION"
podman tag "$IMAGE_PINNED" "$IMAGE_LATEST"

if [[ "$CONVERT" == yes ]]; then
  python3 "$HASH_KEYS" "$ENVFILE"   # idempotent; names only on stdout; no backup
fi

systemctl --user restart $UNITS
for i in 1 2 3 4 5; do
  sleep $((i * 2))
  curl -sf http://localhost:8968/health >/dev/null && curl -sf http://localhost:8969/health >/dev/null && break
  [[ $i -eq 5 ]] && { echo "health check failed" >&2; exit 1; }
done

if [[ "$STORE_CHECK" == yes ]]; then
  podman exec mori-advisor python3 /app/scripts/verify-store.py \
    || { echo "STORE CHECK FAILED" >&2; exit 1; }
fi
echo "Deploy OK: $IMAGE_VERSION = $IMAGE_PINNED"
