#!/usr/bin/env bash
# /usr/local/sbin/mori-cd-deploy — root:root 0755. The ForceCommand for the CD deploy user
# (v2.3.17, ruling G3/G6; see mori-deploy.conf). Whatever the client asked for arrives in
# SSH_ORIGINAL_COMMAND; the ONLY accepted form is
#     deploy <vX.Y.Z> <sha256:64hex>
# and it runs exactly one thing: the deploy script, as the mori user, through the one sudoers rule.
# A forced command receives no argv from the client, so `--validate` (tests) can't be reached by ssh.
set -euo pipefail
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
INNER=/usr/local/sbin/mori-cd-deploy-as-mori
TAG_RE='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
DIGEST_RE='^sha256:[0-9a-f]{64}$'

refuse() { echo "refused: $1" >&2; exit 2; }

read -r -a words <<< "${SSH_ORIGINAL_COMMAND:-}"
[[ ${#words[@]} -eq 3 ]] || refuse "expected: deploy <tag> <digest>"
[[ "${words[0]}" == "deploy" ]] || refuse "the only verb is deploy"
[[ "${words[1]}" =~ $TAG_RE ]] || refuse "bad tag"
[[ "${words[2]}" =~ $DIGEST_RE ]] || refuse "bad digest"
# The whole command must be exactly those three words (no shell metacharacters smuggled in).
[[ "${SSH_ORIGINAL_COMMAND}" == "deploy ${words[1]} ${words[2]}" ]] || refuse "unexpected characters"

if [[ "${1:-}" == "--validate" ]]; then
  echo "ok ${words[1]} ${words[2]}"; exit 0
fi
exec sudo -n -u mori "$INNER" "${words[1]}" "${words[2]}"
