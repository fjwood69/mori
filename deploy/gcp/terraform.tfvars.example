# GCP project
project_id = "mori-genai"
region     = "northamerica-northeast2"
zone       = "northamerica-northeast2-a"

# Machine
machine_type  = "e2-small"
disk_size_gb  = 20

# Container
container_image = "ghcr.io/fjwood69/moku:latest"

# Tailscale
tailscale_auth_key = "tskey-auth-..."

# SSH key for VM access (from .secrets or your ~/.ssh/id_*.pub)
ssh_public_key = "ssh-rsa AAAA..."