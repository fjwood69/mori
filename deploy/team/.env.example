# Mori — Team deployment environment (PostgreSQL)
# Copy to .env and fill in all required values.

# ── Required ───────────────────────────────────────────────────────────────

# PostgreSQL password (must match POSTGRES_PASSWORD in docker-compose.yml)
POSTGRES_PASSWORD=changeme

# PostgreSQL DSN — points at pgBouncer (session mode, port 5433)
MORI_DATABASE_URL=postgresql://mori:changeme@pgbouncer:5432/mori

# LLM provider — Bifrost gateway (recommended) or direct OpenAI-compatible
MORI_PROVIDER_MODE=bifrost
MORI_BIFROST_BASE_URL=http://localhost:8787

# API key for event endpoints (set in your MCP client too)
MORI_ADVISOR_API_KEY=

# ── Optional ───────────────────────────────────────────────────────────────

# Dream pipeline interval in minutes (default: 60)
MORI_DREAM_INTERVAL=60

# NATS URL for cross-device messaging
# MORI_NATS_URL=nats://user:pass@nats-host:4222

# Trusted dreamers — hostnames that can approve canonical writes
# MORI_TRUSTED_DREAMERS=alice-macbook,bob-workstation,ci-runner

# MCP server name (shown in Claude Code sidebar)
MORI_MCP_SERVER_NAME=mori

# ── WAL-G backups (optional) ────────────────────────────────────────────────
# Set WALG_GS_PREFIX to activate WAL archiving and daily base backups to GCS.
# Unset = wal-g-cron sidecar idles, no backup. Postgres still runs normally.
# WALG_GS_PREFIX=gs://your-bucket/mori-advisor
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json
