# Mori configuration — generated by `mori-setup`
# Edit this file to change your LLM provider or server settings.
# Restart the service after editing: brew services restart mori

# ── LLM provider ─────────────────────────────────────────────────────────────

MORI_PROVIDER_MODE=direct

# OpenAI-compatible base URL.
# Local (Ollama):  http://localhost:11434/v1
# Novita:          https://api.novita.ai/v3/openai
# DeepInfra:       https://api.deepinfra.com/v1/openai
MORI_BASE_URL=http://localhost:11434/v1

# Provider API key — leave empty for local/no-auth endpoints.
MORI_API_KEY=

# Model for the advisor and dream pipeline.
MORI_ADVISOR_MODEL=moonshotai/kimi-k2.6

# ── Server identity ───────────────────────────────────────────────────────────

# Your machine hostname — set as trusted dreamer so writes go through directly.
MORI_TRUSTED_DREAMERS=

# Named API keys for the server (name:secret pairs, comma-separated).
# The secret here must match the API key you configure in the mori plugin.
# Generate a new secret: python3 -c "import secrets; print(secrets.token_hex(32))"
MORI_API_KEYS=

# ── Data ──────────────────────────────────────────────────────────────────────

# Where memories.db and related files are stored.
MORI_ADVISOR_DATA=

# ── Optional ─────────────────────────────────────────────────────────────────

# Dream pipeline interval in minutes (default: 60)
MORI_DREAM_INTERVAL=60

# MCP server name shown in Claude Code sidebar (default: mori)
MORI_MCP_SERVER_NAME=mori
